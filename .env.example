# Copy to .env for local development. Never commit real secrets.
# Production values belong in Freebuff Sites -> Secrets (or your host's secret store).

# Founder bootstrap account (only used when the database is first created)
FOUNDER_EMAIL=founder@duskanddew.com
FOUNDER_PASSWORD=change-this-before-launch

# Public origin used in payment callbacks
APP_ORIGIN=http://localhost:3000

# Payment providers (leave blank until the merchant accounts are verified)
PAYSTACK_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
PAYMENT_WEBHOOK_SECRET=

# Sandbox payment page. Set to 1 ONLY for local testing; never in production.
PAYMENTS_OFFLINE=

# Transactional email (leave blank until the sending domain is verified)
RESEND_API_KEY=
EMAIL_FROM=
